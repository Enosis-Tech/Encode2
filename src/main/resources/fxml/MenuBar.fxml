<?xml version="1.0" encoding="UTF-8" ?>

<?import dev.reymon.graphics.javafx.*?>


<MenuBar xmlns:fx="https://javafx.com/fxml" fx:controller="com.github.enosisTech.MenuBarController">

	<Menu fx:id="file">
		
		<MenuItem fx:id="openFile" onAction="#openAction"/>
		<MenuItem fx:id="closeFile" onAction="#closeAction"/>
		
	</Menu>
	
	<Menu fx:id="setting">
	
		<Menu fx:id="languageSetting">
			
			<MenuItem fx:id="es"/>
			<MenuItem fx:id="en"/>
			<MenuItem fx:id="el"/>
			<MenuItem fx:id="de"/>
			
		</Menu>
	
	</Menu>
	
	<Menu fx:id="help">
		
		<MenuItem fx:id="supportHelp"/>
		<MenuItem fx:id="exitHelp"/>
		
	</Menu>

</MenuBar>