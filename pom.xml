<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>app.enosistech.encode2</groupId>
	<artifactId>Encode2</artifactId>
	<version>0.1.0</version>
	<name>Encode2</name>
	<description>Enosis Code IDE V2</description>

	<properties>
		<maven.compiler.release>25</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<javafx.version>25</javafx.version>
		<javafx.platform>linux</javafx.platform>

		<app.module>Encode2</app.module>
		<app.main>com.github.enosisTech.Encode2</app.main>
		<dist>${project.build.directory}/dist</dist>
		<modules.dir>${project.build.directory}/modules</modules.dir>

		<jdk.linux>${project.basedir}/jdk/linux/x64/jmods</jdk.linux>
		<jdk.win>${project.basedir}/jdk/windows/x64/jmods</jdk.win>
		<jdk.macarm>${project.basedir}/jdk/mac/aarch64/Contents/Home/jmods</jdk.macarm>

		<jfx.linux>${project.basedir}/jmods/javafx/linux/x64</jfx.linux>
		<jfx.win>${project.basedir}/jmods/javafx/windows/x64</jfx.win>
		<jfx.mac>${project.basedir}/jmods/javafx/mac/x64</jfx.mac>
		<jfx.macarm>${project.basedir}/jmods/javafx/mac/aarch64</jfx.macarm>

		<module.richtext>org.fxmisc.richtext</module.richtext>

		<jdkdir>${project.basedir}/jdk/linux/x64</jdkdir>
		<jlink.exe>${jdkdir}/bin/jlink</jlink.exe>
		<jpackage.exe>${jdkdir}/bin/jpackage</jpackage.exe>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.fxmisc.richtext</groupId>
			<artifactId>richtextfx</artifactId>
			<version>0.11.7</version>
		</dependency>

		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-base</artifactId>
			<version>${javafx.version}</version>
			<classifier>${javafx.platform}</classifier>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
			<classifier>${javafx.platform}</classifier>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-graphics</artifactId>
			<version>${javafx.version}</version>
			<classifier>${javafx.platform}</classifier>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-fxml</artifactId>
			<version>${javafx.version}</version>
			<classifier>${javafx.platform}</classifier>
			<scope>provided</scope>
		</dependency>

	</dependencies>

	<profiles>

		<!--
		#######################################
		### Profile for compiling for Linux ###
		#######################################
		-->

		<profile>

			<id>host-linux</id>

			<activation>
				<os>
					<family>unix</family>
					<name>Linux</name>
				</os>
			</activation>

			<properties>
				<javafx.platform>linux</javafx.platform>
				
				<jdkdir>${project.basedir}/jdk/linux/x64</jdkdir>
				<jlink.exe>${jdkdir}/bin/jlink</jlink.exe>
				<jpackage.exe>${jdkdir}/bin/jpackage</jpackage.exe>
			</properties>

		</profile>

		<!--
		#########################################
		### Profile for compiling for Windows ###
		#########################################
		-->

		<profile>

			<id>host-win</id>

			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>

			<properties>
				<javafx.platform>win</javafx.platform>
				
				<jdkdir>${project.basedir}/jdk/windows/x64</jdkdir>
				<jlink.exe>${jdkdir}/bin/jlink</jlink.exe>
				<jpackage.exe>${jdkdir}/bin/jpackage</jpackage.exe>
			</properties>

		</profile>

		<!--
		########################################################
		### Profile for compiling for Mac with ARM procesors ###
		########################################################
		-->

		<profile>

			<id>host-mac-arm</id>
			<activation>
				<os>
					<family>mac</family>
					<arch>aarch64</arch>
				</os>
			</activation>
			<properties>
				<javafx.platform>mac-aarch64</javafx.platform>

				<jdkdir>${project.basedir}/jdk/mac/aarch64/Contents/Home</jdkdir>
				<jlink.exe>${jdkdir}/bin/jlink</jlink.exe>
				<jpackage.exe>${jdkdir}/bin/jpackage</jpackage.exe>
			</properties>

		</profile>

	</profiles>


	<build>
		<plugins>

			<!--
			##########################
			###	Copy for compiling ###
			##########################
			-->

			<plugin>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>

				<executions>
					<execution>

						<id>copy-deps</id>
						<phase>prepare-package</phase>

						<goals>
							<goal>copy-dependencies</goal>
						</goals>

						<configuration>
							<outputDirectory>${modules.dir}</outputDirectory>
							<includeScope>runtime</includeScope>
						</configuration>

					</execution>
				</executions>
			</plugin>

			<!--
			##########################
			###	Create Directories ###
			##########################
			-->

			<plugin>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>

				<executions>

					<execution>
						<id>create-compress-dirs</id>
						<phase>package</phase>

						<goals>
							<goal>run</goal>
						</goals>

						<configuration>
							<target>
								<mkdir dir="${dist}/Compress/Runtime" />
								<mkdir dir="${dist}/Compress/Package" />
							</target>
						</configuration>
					</execution>

				</executions>
			</plugin>

			<!--
			##########################
			###	Convert to modules ###
			##########################
			-->

			<plugin>
				<groupId>org.moditect</groupId>
				<artifactId>moditect-maven-plugin</artifactId>
				<version>1.2.2.Final</version>

				<executions>
					<execution>
						<id>add-module-infos</id>
						<phase>package</phase>

						<goals>
							<goal>add-module-info</goal>
						</goals>

						<configuration>
							<outputDirectory>${modules.dir}</outputDirectory>
							<overwriteExistingFiles>true</overwriteExistingFiles>

							<jdepsExtraArgs>
								<arg>--ignore-missing-deps</arg>
							</jdepsExtraArgs>

							<modules>

								<module>
									<artifact>
										<groupId>org.fxmisc.wellbehaved</groupId>
										<artifactId>wellbehavedfx</artifactId>
										<version>0.3.3</version>
									</artifact>

									<moduleInfo>
										<name>org.fxmisc.wellbehaved</name>
										<exports>*;</exports>
									</moduleInfo>
								</module>

								<module>
									<artifact>
										<groupId>org.reactfx</groupId>
										<artifactId>reactfx</artifactId>
										<version>2.0-M5</version>
									</artifact>

									<moduleInfo>
										<name>org.reactfx</name>
										<exports>*;</exports>
									</moduleInfo>
								</module>

								<module>
									<artifact>
										<groupId>org.fxmisc.flowless</groupId>
										<artifactId>flowless</artifactId>
										<version>0.7.4</version>
									</artifact>

									<moduleInfo>
										<name>org.fxmisc.flowless</name>
										<exports>*;</exports>
									</moduleInfo>
								</module>

								<module>
									<artifact>
										<groupId>org.fxmisc.undo</groupId>
										<artifactId>undofx</artifactId>
										<version>2.1.1</version>
									</artifact>

									<moduleInfo>
										<name>org.fxmisc.undo</name>
										<exports>*;</exports>
									</moduleInfo>
								</module>

								<module>
									<artifact>
										<groupId>org.fxmisc.richtext</groupId>
										<artifactId>richtextfx</artifactId>
										<version>0.11.7</version>
									</artifact>

									<moduleInfo>
										<name>org.fxmisc.richtext</name>
										<exports>*;</exports>
									</moduleInfo>
								</module>

							</modules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
			###################################
			### Create distribution formats ###
			###################################
			-->

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>

				<executions>

					<!--
					***********************************
					***	Create executable for Linux ***
					***********************************
					-->

					<execution>

						<id>JLink-Linux-x64</id>
						<phase>package</phase>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>

							<executable>${jlink.exe}</executable>

							<arguments>

								<argument>--module-path</argument>
								<argument>
									${jdk.linux}${path.separator}${jfx.linux}${path.separator}${project.build.directory}/${project.build.finalName}.jar${path.separator}${modules.dir}
								</argument>

								<argument>--add-modules</argument>
								<argument>${app.module}</argument>
								<argument>--launcher</argument>

								<argument>
									${app.module}=${app.module}/${app.main}
								</argument>

								<argument>
									--add-options=--enable-native-access=javafx.graphics
								</argument>

								<argument>--strip-debug</argument>
								<argument>--no-header-files</argument>
								<argument>--no-man-pages</argument>
								<argument>--compress=zip-6</argument>
								<argument>--output</argument>
								<argument>${dist}/linux/x64</argument>

							</arguments>

						</configuration>

					</execution>

					<!--
					*************************************
					***	Create executable for Windows ***
					*************************************
					-->

					<execution>

						<id>JLink-Windows-x64</id>
						<phase>package</phase>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>

							<executable>${jlink.exe}</executable>

							<arguments>

								<argument>--module-path</argument>

								<argument>
									${jdk.win}${path.separator}${jfx.win}${path.separator}${project.build.directory}/${project.build.finalName}.jar${path.separator}${modules.dir}
								</argument>

								<argument>--add-modules</argument>
								<argument>${app.module}</argument>
								<argument>--launcher</argument>

								<argument>
									${app.module}=${app.module}/${app.main}
								</argument>

								<argument>
									--add-options=--enable-native-access=javafx.graphics
								</argument>

								<argument>--strip-debug</argument>
								<argument>--no-header-files</argument>
								<argument>--no-man-pages</argument>
								<argument>--compress=zip-6</argument>
								<argument>--output</argument>
								<argument>${dist}/windows/x64</argument>

							</arguments>

						</configuration>

					</execution>

					<!--
					***********************************
					***	Create executable for MacOS ***
					***********************************
					-->

					<execution>

						<id>JLink-Mac-aarch64</id>
						<phase>package</phase>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>

							<executable>${jlink.exe}</executable>

							<arguments>

								<argument>--module-path</argument>

								<argument>
									${jdk.macarm}${path.separator}${jfx.macarm}${path.separator}${project.build.directory}/${project.build.finalName}.jar${path.separator}${modules.dir}
								</argument>

								<argument>--add-modules</argument>
								<argument>${app.module}</argument>
								<argument>--launcher</argument>

								<argument>
									${app.module}=${app.module}/${app.main}
								</argument>

								<argument>
									--add-options=--enable-native-access=javafx.graphics
								</argument>

								<argument>--strip-debug</argument>
								<argument>--no-header-files</argument>
								<argument>--no-man-pages</argument>
								<argument>--compress=zip-6</argument>
								<argument>--output</argument>
								<argument>${dist}/mac/aarch64</argument>

							</arguments>

						</configuration>

					</execution>

					<!--
					***********************************
					***	Create a Packages for Linux ***
					***********************************
					-->

					<execution>

						<id>JPackage-Linux-Debian-x64</id>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>
							<executable>${jpackage.exe}</executable>

							<arguments>

								<argument>--type</argument>
								<argument>deb</argument>

								<argument>--name</argument>
								<argument>Encode2</argument>

								<argument>--app-version</argument>
								<argument>${project.version}</argument>

								<argument>--vendor</argument>
								<argument>Enosis Tehcnology</argument>

								<argument>--runtime-image</argument>
								<argument>${dist}/linux/x64</argument>

								<argument>--module</argument>
								<argument>${app.module}/${app.main}</argument>

								<argument>--dest</argument>
								<argument>${dist}/package/linux</argument>

							</arguments>

						</configuration>

					</execution>

					<execution>

						<id>JPackage-Linux-RedHat-x64</id>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>

							<executable>${jpackage.exe}</executable>

							<arguments>

								<argument>--type</argument>
								<argument>rpm</argument>

								<argument>--name</argument>
								<argument>Encode2</argument>

								<argument>--app-version</argument>
								<argument>${project.version}</argument>

								<argument>--vendor</argument>
								<argument>Enosis Tehcnology</argument>

								<argument>--runtime-image</argument>
								<argument>${dist}/linux/x64</argument>

								<argument>--module</argument>
								<argument>${app.module}/${app.main}</argument>

								<argument>--dest</argument>
								<argument>${dist}/package/linux</argument>

							</arguments>

						</configuration>

					</execution>


					<!--
					*************************************
					***	Create a Packages for Windows ***
					*************************************
					-->

					<execution>

						<id>JPackage-Windows-Microsoft-Installer-x64</id>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>

							<executable>${jpackage.exe}</executable>

							<arguments>

								<argument>--type</argument>
								<argument>msi</argument>

								<argument>--name</argument>
								<argument>Encode2</argument>

								<argument>--app-version</argument>
								<argument>${project.version}</argument>

								<argument>--vendor</argument>
								<argument>Enosis Tehcnology</argument>

								<argument>--runtime-image</argument>
								<argument>${dist}/windows/x64</argument>

								<argument>--module</argument>
								<argument>${app.module}/${app.main}</argument>

								<argument>--dest</argument>
								<argument>${dist}/package/windows</argument>

							</arguments>

						</configuration>

					</execution>

					<execution>

						<id>JPackage-Windows-Executable-x64</id>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>

							<executable>${jpackage.exe}</executable>

							<arguments>

								<argument>--type</argument>
								<argument>exe</argument>

								<argument>--name</argument>
								<argument>Encode2</argument>

								<argument>--app-version</argument>
								<argument>${project.version}</argument>

								<argument>--vendor</argument>
								<argument>Enosis Tehcnology</argument>

								<argument>--runtime-image</argument>
								<argument>${dist}/windows/x64</argument>

								<argument>--module</argument>
								<argument>${app.module}/${app.main}</argument>

								<argument>--dest</argument>
								<argument>${dist}/package/windows</argument>

							</arguments>

						</configuration>

					</execution>

					<!--
					***********************************
					***	Create a Packages for MacOS ***
					***********************************
					-->

					<execution>

						<id>JPackage-Mac-DMG-aarch64</id>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>
							<executable>${jpackage.exe}</executable>

							<arguments>

								<argument>--type</argument>
								<argument>dmg</argument>

								<argument>--name</argument>
								<argument>Encode2</argument>

								<argument>--app-version</argument>
								<argument>${project.version}</argument>

								<argument>--vendor</argument>
								<argument>Enosis Tehcnology</argument>

								<argument>--runtime-image</argument>
								<argument>${dist}/mac/aarch64</argument>

								<argument>--module</argument>
								<argument>${app.module}/${app.main}</argument>

								<argument>--dest</argument>
								<argument>${dist}/package/mac</argument>

							</arguments>

						</configuration>

					</execution>

					<execution>

						<id>JPackage-Mac-PKG-aarch64</id>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>

							<executable>${jpackage.exe}</executable>

							<arguments>

								<argument>--type</argument>
								<argument>exe</argument>

								<argument>--name</argument>
								<argument>Encode2</argument>

								<argument>--app-version</argument>
								<argument>${project.version}</argument>

								<argument>--vendor</argument>
								<argument>Enosis Tehcnology</argument>

								<argument>--runtime-image</argument>
								<argument>${dist}/mac/aarch64</argument>

								<argument>--module</argument>
								<argument>${app.module}/${app.main}</argument>

								<argument>--dest</argument>
								<argument>${dist}/package/mac</argument>

							</arguments>

						</configuration>

					</execution>

					<!-- 
					********************************
					***	Package Runtime of Linux ***
					********************************
					-->

					<execution>
						<id>Compress-Linux-Runtime</id>
						<phase>package</phase>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>
							<executable>tar</executable>

							<arguments>

								<argument>-czf</argument>
								<argument>
									${dist}/Compress/Runtime/Encode2-Linux-Runtime.tar.gz
								</argument>

								<argument>-C</argument>
								<argument>${dist}/linux</argument>
								<argument>x64/</argument>

							</arguments>
						</configuration>
					</execution>

					<!-- 
					********************************
					***	Compress Windows Runtime ***
					********************************
					-->

					<execution>
						<id>Compress-Windows-Runtime</id>
						<phase>package</phase>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>
							<executable>${java.home}/bin/jar</executable>

							<arguments>

								<argument>--create</argument>
								<argument>--no-manifest</argument>
								<argument>--file</argument>
								<argument>
									${dist}/Compress/Runtime/Encode2-Windows-Runtime.zip
								</argument>

								<argument>-C</argument>
								<argument>${dist}/windows</argument>
								<argument>x64/</argument>

							</arguments>
						</configuration>
					</execution>

					<!-- 
					****************************
					***	Compress Mac Runtime ***
					****************************
					-->

					<execution>
						<id>Compress-Mac-Runtime</id>
						<phase>package</phase>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>
							<executable>tar</executable>

							<arguments>

								<argument>-czf</argument>
								<argument>
									${dist}/Compress/Runtime/Encode2-Mac-Runtime.tar.gz
								</argument>

								<argument>-C</argument>
								<argument>${dist}/mac</argument>
								<argument>aarch64/</argument>

							</arguments>
						</configuration>
					</execution>

					<!--
					***********************************
					***	Compress Packages for Linux ***
					***********************************
					-->

					<execution>
						<id>Compress-Linux-Package</id>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>
							<executable>tar</executable>

							<arguments>

								<argument>-czf</argument>
								<argument>
									${dist}/Compress/Package/Encode2-Linux.tar.gz
								</argument>

								<argument>-C</argument>
								<argument>${dist}/package</argument>
								<argument>linux/</argument>

							</arguments>
						</configuration>
					</execution>

					<!--
					*************************************
					***	Compress Packages for Windows ***
					*************************************
					-->

					<execution>
						<id>Compress-Windows-Package</id>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>
							<executable>${java.home}/bin/jar</executable>

							<arguments>

								<argument>--create</argument>
								<argument>--no-manifest</argument>
								<argument>--file</argument>
								<argument>
									${dist}/Compress/Package/Encode2-Windows.zip
								</argument>

								<argument>-C</argument>
								<argument>${dist}/package</argument>
								<argument>windows/</argument>

							</arguments>
						</configuration>
					</execution>

					<!--
					*********************************
					***	Compress Packages for Mac ***
					*********************************
					-->

					<execution>
						<id>Compress-Mac-Package</id>

						<goals>
							<goal>exec</goal>
						</goals>

						<configuration>
							<executable>tar</executable>

							<arguments>

								<argument>-czf</argument>
								<argument>
									${dist}/Compress/Package/Encode2-Mac.tar.gz
								</argument>

								<argument>-C</argument>
								<argument>${dist}/package</argument>
								<argument>mac/</argument>

							</arguments>
						</configuration>
					</execution>

				</executions>
			</plugin>
		</plugins>
	</build>
</project>